# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …pero la plantilla sí va al repo: no lleva credenciales, sólo los nombres.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor: el proyecto Android SÍ va al repo — tiene los íconos del club y la
# configuración, que se perderían al regenerarlo. Sólo se excluye lo que produce
# la compilación.
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
/android/app/src/main/assets/public/
/android/capacitor-cordova-android-plugins/

# El APK compilado no va al repo: son 4,6 MB y se regenera con `npm run apk`
*.apk
